# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EARTHDATA_TOKEN: Optional NASA Earthdata Bearer token for authenticated CMR/AppEEARS granule requests.
# Public NASA ORNL DAAC MODIS, NASA POWER, NASA CMR, and Open-Meteo ERA5 endpoints work without credentials.
EARTHDATA_TOKEN=""
